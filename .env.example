# ===================================================================================
# Cybersecurity Threat Monitoring System - Environment Configuration
# ===================================================================================

# Cloud Database Connection String (PostgreSQL on Render, Neon, Supabase, Railway)
# Example: postgresql://username:password@dpg-xxxx.render.com/cyber_threat_db
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cyber_threat_db

# Cryptographic Keys (Generate random 32-character strings for production)
API_SECRET=cyber-soc-production-secret-replace-me-12345
JWT_SECRET=jwt-defense-guard-token-secret-replace-me-67890

# Allowed CORS Origins (Frontend URL in production, or * for open evaluation)
CORS_ORIGINS=*

# Environment Mode: development or production
FLASK_ENV=production
PORT=5000
HOST=0.0.0.0
